# Configuration de Cv en Ligne — copier ce fichier en .env puis adapter.
# Configuration for Cv en Ligne — copy this file to .env and adjust.
#
# IMPORTANT : site statique, sans base de données ni serveur applicatif.
# Toute variable VITE_* est intégrée au code envoyé au navigateur : n'y mettez JAMAIS de secret.
# Every VITE_* variable ends up in the browser bundle: NEVER put a secret here.

# Nom du site affiché dans l'en-tête / Site name shown in the header
VITE_SITE_NAME="Cv en Ligne"

# Langue par défaut : fr ou en / Default language: fr or en
VITE_DEFAULT_LOCALE=fr

# Port publié par docker compose sur la machine hôte / Host port published by docker compose
WEB_PORT=8080
